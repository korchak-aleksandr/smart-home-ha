# Copy to .env on the server and adjust. .env is git-ignored; never commit real values.

# Timezone for containers, e.g. Europe/Nicosia, Europe/Berlin (list: timedatectl list-timezones)
TZ=Europe/Nicosia

# Grafana admin password (user "admin"). Generate: openssl rand -base64 24
# Used on Grafana's first start only; later changes go through Grafana itself (see docs/08-monitoring.md).
GRAFANA_ADMIN_PASSWORD=
