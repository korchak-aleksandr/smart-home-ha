{
 "uid": "energy-cost",
 "title": "Energy & cost",
 "description": "Estimated electricity use and cost of the server, from Intel RAPL. Edit price/factor/offset in the variables.",
 "tags": [
  "home-server"
 ],
 "timezone": "browser",
 "editable": false,
 "schemaVersion": 41,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "price",
    "label": "Price, \u20ac/kWh",
    "type": "textbox",
    "query": "0.337",
    "current": {
     "text": "0.337",
     "value": "0.337"
    },
    "description": "Marginal electricity price incl. VAT (Cyprus EAC tariff 01 example: generation + network + fuel adjustment + PSO, \u00d71.05 VAT, + RES fund). Update when the fuel adjustment changes."
   },
   {
    "name": "factor",
    "label": "RAPL factor",
    "type": "textbox",
    "query": "1.3",
    "current": {
     "text": "1.3",
     "value": "1.3"
    },
    "description": "Wall power \u2248 CPU package power (RAPL) \u00d7 factor + offset. RAPL covers the CPU package only."
   },
   {
    "name": "offset",
    "label": "Offset, W",
    "type": "textbox",
    "query": "0",
    "current": {
     "text": "0",
     "value": "0"
    },
    "description": "Constant watts added for SSD, Wi-Fi, PSU losses. Calibrate with a wall power meter if you have one."
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Power now",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(node_rapl_package_joules_total[5m])) * $factor + $offset)",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   }
  },
  {
