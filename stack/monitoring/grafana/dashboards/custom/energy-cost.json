    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(increase(node_rapl_package_joules_total[$__range])) * $factor / 3.6e6 + $offset * $__range_s / 3600 / 1000)",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "value",
