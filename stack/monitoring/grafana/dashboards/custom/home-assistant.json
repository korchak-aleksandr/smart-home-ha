{
 "uid": "home-assistant",
 "title": "Home Assistant",
 "description": "HA health (unavailable entities, updates, resources) and allow-listed home sensors.",
 "tags": [
  "home-server"
 ],
 "timezone": "browser",
 "editable": false,
 "schemaVersion": 41,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Health",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Home Assistant",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(up{job=\"homeassistant\"})",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "1 = metrics endpoint answers (HA is running)."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Unavailable entities",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(hass_entity_available == 0) or vector(0)",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "description": "Exported entities that HA reports as unavailable (hass_entity_available = 0): a device or integration is down."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Updates available",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
