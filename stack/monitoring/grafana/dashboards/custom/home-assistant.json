{
 "uid": "home-assistant",
 "title": "Home Assistant",
 "description": "HA health (unavailable entities, updates, resources) and allow-listed home sensors.",
 "tags": [
  "home-server"
 ],
 "timezone": "browser",
 "editable": false,
 "schemaVersion": 41,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Health",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Home Assistant",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(up{job=\"homeassistant\"})",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "1 = metrics endpoint answers (HA is running)."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Unavailable entities",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(hass_entity_available == 0) or vector(0)",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "description": "Exported entities that HA reports as unavailable (hass_entity_available = 0): a device or integration is down."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Updates available",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(hass_update_state)",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "description": "Pending updates of HA core and integrations (update.* entities)."
  },
  {
   "id": 5,
   "type": "stat",
   "title": "HA uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(process_start_time_seconds{job=\"homeassistant\"})",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "HA memory",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(process_resident_memory_bytes{job=\"homeassistant\"})",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "HA CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"homeassistant\"}[5m]))",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Entity availability",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "hass_entity_available",
     "legendFormat": "{{friendly_name}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0,
      "axisSoftMax": 1
     },
     "decimals": 0
    },
    "overrides": []
   },
   "description": "1 = available, 0 = unavailable (per exported entity)."
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "HA process",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(process_cpu_seconds_total{job=\"homeassistant\"}[$__rate_interval])",
     "legendFormat": "CPU (cores)"
    },
    {
     "refId": "B",
     "expr": "process_resident_memory_bytes{job=\"homeassistant\"} / 1e9",
     "legendFormat": "memory (GB)"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0
     }
    },
    "overrides": []
   }
  },
