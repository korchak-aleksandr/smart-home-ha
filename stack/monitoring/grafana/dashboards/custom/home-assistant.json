  {
   "id": 16,
   "type": "stat",
   "title": "Air quality index",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "hass_sensor_state{entity=\"sensor.outdoor_air_quality_index\"}",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 2
       },
       {
        "color": "orange",
        "value": 3
       },
       {
        "color": "red",
        "value": 4
       }
      ]
     },
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "1 low"
        },
        "2": {
         "text": "2 moderate"
        },
        "3": {
         "text": "3 high"
        },
        "4": {
         "text": "4 very high"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "description": "Index of the nearest official station: 1 low, 2 moderate, 3 high, 4 very high."
